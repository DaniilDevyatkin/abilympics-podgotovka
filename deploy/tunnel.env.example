# Параметры обратного SSH-туннеля. Скопировать в ~/.config/abilympics-tunnel.env
# и заполнить своими значениями. Файл не должен быть доступен другим: chmod 600.

# IP или доменное имя VDS
REMOTE_HOST=203.0.113.10

# Пользователь на VDS (не root, если можно — меньше прав)
REMOTE_USER=deploy

# Порт, который sshd на VDS откроет только на своём localhost (127.0.0.1).
# nginx на VDS будет проксировать на него. В интернет этот порт не смотрит.
REMOTE_PORT=18099
